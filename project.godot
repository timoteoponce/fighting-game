; Engine configuration file.
; Open this folder with Godot 4.7+ (or run: godot --path .)

config_version=5

[application]

config/name="PJ's Clash"
config/description="A 2D fighting game in the style of Marvel vs Capcom, starring Ulises and Emilia."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Controls="*res://autoload/controls.gd"
GameState="*res://autoload/game_state.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/mode=3
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

anti_aliasing/quality/msaa_2d=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
