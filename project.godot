; Engine configuration file.
; Open this folder with Godot 4.7+ (or run: godot --path .)

config_version=5

[application]

config/name="PJ's Clash"
config/description="A 2D fighting game in the style of Marvel vs Capcom, starring Ulises and Emilia."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
; The sim is a fixed 60 Hz. A 120 Hz phone would otherwise render twice the
; frames for no gain, and every one of them costs battery.
run/max_fps=60

[autoload]

Controls="*res://autoload/controls.gd"
GameState="*res://autoload/game_state.gd"
Sfx="*res://autoload/sfx.gd"
Settings="*res://autoload/settings.gd"

[display]

window/size/mode=3
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[importer_defaults]

texture={
"compress/mode": 0
}

[rendering]

; MUST stay Disabled. The whole look is a 320x180 buffer scaled by an integer;
; anti-aliasing softens exactly those pixels, and on a phone it costs a 4x
; multisample of the full canvas every frame. The arena SubViewport turns it
; off again in code; this is the root viewport (HUD, menus, the scaled frame).
anti_aliasing/quality/msaa_2d=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
